# Conexión de la aplicación (rol SIN privilegios de propietario: le aplica el aislamiento por empresa)
DATABASE_URL=postgres://runflow_app:runflow_app@localhost:5432/runflow
# Conexión del propietario de las tablas (solo para migraciones)
DATABASE_OWNER_URL=postgres://runflow:runflow@localhost:5432/runflow
# Rol de la aplicación al que se conceden permisos tras migrar
DATABASE_APP_ROLE=runflow_app

PORT=3000
HOST=0.0.0.0
# cloud | station
RUNFLOW_MODE=cloud
# true detrás de HTTPS (producción)
COOKIE_SECURE=false
# true si hay un proxy inverso delante (Caddy, Nginx, Cloudflare)
TRUST_PROXY=false
SESSION_TTL_DAYS=14
